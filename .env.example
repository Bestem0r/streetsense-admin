# Copy to .env and adjust; docker compose reads .env automatically.
# Every value below has a working default in compose.yaml, so .env is optional.

# --- Published host ports ---
FRONTEND_PORT=8080
BACKEND_PORT=9091
KAFKA_SERVICE_PORT=9095
MONGO_PORT=27018   # host port only; the stack always talks to 27017 internally
KAFKA_PORT=29092

# --- MongoDB ---
MONGO_USERNAME=admin
MONGO_PASSWORD=secret
MONGO_DATABASE=vegobject

# --- Backend secrets ---
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-64-characters-for-hs512

# --- Outgoing mail (password reset / notifications). Leave blank to disable. ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
